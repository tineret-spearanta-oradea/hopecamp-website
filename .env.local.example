# Optional: API key for UploadThing (https://uploadthing.com) if using file uploads.
UPLOADTHING_TOKEN=

# Supabase local development URL (usually correct as is after `supabase start`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publicly accessible Supabase key (anon key). Get this from `supabase start` output.
# Needs NEXT_PUBLIC_ prefix to be available in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY="<YOUR_SUPABASE_ANON_KEY>"

# Supabase secret key for server-side operations (service role key). Get this from `supabase start` output.
# DO NOT expose this key in the browser or commit it to version control.
SUPABASE_SERVICE_ROLE_KEY="<YOUR_SUPABASE_SERVICE_ROLE_KEY>"
